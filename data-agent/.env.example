# 复制为 .env，并使用部署方自己的值；不要提交填写后的文件。
APP_ENV=development

# 元数据账号：仅在独立元数据库内授予初始化及运行所需权限。
DB_META_HOST=127.0.0.1
DB_META_PORT=3306
DB_META_DATABASE=da_meta
DB_META_USER=da_meta_app
DB_META_PASSWORD=

# 数仓查询账号：仅授予获准表或视图的 SELECT 权限。
DB_DW_HOST=127.0.0.1
DB_DW_PORT=3306
DB_DW_DATABASE=da_warehouse
DB_DW_USER=da_reader
DB_DW_PASSWORD=

# 填写已验证可用的模型与端点。openai 对应 OpenAI-compatible 适配器。
# 不同供应商的 thinking、temperature 等参数必须按实际能力配置。
LLM_PROVIDER=openai
LLM_MODEL_NAME=replace-with-your-model-id
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_THINKING_MODE=auto
LLM_TEMPERATURE=0

# 两个不同的随机秘密；AUTH_SECRET_KEY 至少 32 个字符。
AUTH_SECRET_KEY=
MASKING_HASH_SALT=

# 外部 BGE-M3 模型目录；仓库不分发模型权重。
BGE_M3_PATH=/absolute/path/to/bge-m3
BGE_M3_REVISION=local
BGE_M3_DEVICE=auto
BGE_M3_RUNTIME_MODE=microbatch

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
ES_HOST=127.0.0.1
ES_PORT=9200
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
REQUESTS_PER_MINUTE=120
MAX_REQUEST_BYTES=12582912
# 评测接口默认不开放；运行正式评测前另行准备数据集和授权。
EVALUATION_HTTP_ENABLED=false
